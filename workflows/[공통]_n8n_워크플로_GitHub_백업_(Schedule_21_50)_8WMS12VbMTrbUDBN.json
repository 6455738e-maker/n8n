  "nodes": [
    {
      "id": "8f14e45f-ceea-467e-9575-2d0b1a4d1e01",
      "name": "매일 21:50",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -400,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "50 21 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "c81e728d-9d4c-4f1c-b5e1-7a2a2c1c1e02",
      "name": "워크플로 목록 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -160,
        0
      ],
      "parameters": {
        "url": "http://localhost:5678/api/v1/workflows",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "n8nApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "250"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "n8nApi": {
          "id": "Mio9h9fLRCDsXxfM",
          "name": "n8n API (self)"
        }
      }
    },
    {
      "id": "eccbc87e-4b5c-4f2e-8a3a-1e4c1c1e0303",
      "name": "GitHub 업로드용 변환",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const res = $input.first().json;\nconst workflows = res.data || res || [];\n\nfunction safeName(name, id) {\n  const cleaned = String(name || id)\n    .trim()\n    .replace(/[\\\\/:*?\"<>|]/g, '_')\n    .replace(/\\s+/g, '_');\n  return cleaned || id;\n}\n\nreturn workflows.map(wf => {\n  const fileName = `${safeName(wf.name, wf.id)}_${wf.id}.json`;\n  const content = JSON.stringify(wf, null, 2);\n  const contentBase64 = Buffer.from(content, 'utf-8').toString('base64');\n  return {\n    json: {\n      id: wf.id,\n      name: wf.name,\n      fileName,\n      path: `workflows/${fileName}`,\n      contentBase64\n    }\n  };\n});"
      }
    },
    {
      "id": "a87ff679-a2f3-4b1c-8d4c-1e4c1c1e0404",
      "name": "워크플로별 반복",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        320,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "e4da3b7f-bbce-4e1c-9d3a-1e4c1c1e0505",
      "name": "기존 파일 SHA 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "onError": "continueRegularOutput",
      "position": [
        560,
        100
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/6455738e-maker/n8n/contents/{{ $json.path }}",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "p5GlP1LHYwq4EOz9",
          "name": "GitHub PAT (n8n backup)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "1679091c-5a88-4c1e-9b1a-1e4c1c1e0606",
      "name": "커밋 요청 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        100
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const shaRes = $input.first().json;\nconst wf = $('워크플로별 반복').item.json;\n\nconst sha = (shaRes && !shaRes.error && shaRes.sha) ? shaRes.sha : undefined;\n\nconst body = {\n  message: `chore: backup workflow ${wf.name} (${new Date().toISOString()})`,\n  content: wf.contentBase64,\n  branch: 'main'\n};\nif (sha) body.sha = sha;\n\nreturn [{ json: { path: wf.path, body } }];"
      }
    },
    {
      "id": "c9f0f895-fb98-4a1c-9c1a-1e4c1c1e0707",
      "name": "GitHub에 커밋",
