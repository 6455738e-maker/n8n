{"updatedAt":"2026-09-10T09:31:26.797Z","createdAt":"2026-09-03T06:18:00.224Z","id":"Hzu2rOOrCdf95aup","name":"[공통] 좋은 글귀 생성 (Manual)","description":null,"active":false,"isArchived":false,"nodes":[{"id":"manual-trigger-1","name":"트리거 (버튼 클릭)","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[250,300],"parameters":{}},{"id":"code-quote-1","name":"좋은 글귀 생성","type":"n8n-nodes-base.code","typeVersion":2,"position":[550,300],"parameters":{"jsMode":"runOnceForAllItems","jsCode":"const quotes = [\n  \"오늘 걷지 않으면 내일은 뛰어야 한다.\",\n  \"실패는 성공으로 가는 길 위에 놓인 디딤돌이다.\",\n  \"어제와 똑같이 살면서 다른 미래를 기대하는 것은 망상이다.\",\n  \"작은 습관이 모여 큰 인생을 만든다.\",\n  \"시작이 반이다.\",\n  \"할 수 있다고 믿는 사람이 결국 해낸다.\",\n  \"고통 없이는 얻는 것도 없다.\",\n  \"가장 큰 위험은 아무 위험도 감수하지 않는 것이다.\",\n  \"완벽을 기다리지 말고 지금 시작하라.\",\n  \"포기하고 싶을 때가 바로 포기하지 말아야 할 때다.\"\n];\n\nconst randomIndex = Math.floor(Math.random() * quotes.length);\n\nreturn [\n  {\n    json: {\n      quote: quotes[randomIndex],\n      generatedAt: new Date().toISOString()\n    }\n  }\n];"}}],"connections":{"트리거 (버튼 클릭)":{"main":[[{"node":"좋은 글귀 생성","type":"main","index":0}]]}},"settings":{"saveExecutionProgress":true,"saveManualExecutions":true,"saveDataErrorExecution":"all","saveDataSuccessExecution":"all","executionOrder":"v1","errorWorkflow":"d0cJdb6254pCsYsY"},"staticData":null,"meta":null,"nodeGroups":[],"pinData":null,"versionId":"b0b859ef-741a-4eed-b834-4f34b3075c96","activeVersionId":null,"versionCounter":2,"triggerCount":0,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-09-03T06:18:00.224Z","createdAt":"2026-09-03T06:18:00.224Z","role":"workflow:owner","workflowId":"Hzu2rOOrCdf95aup","projectId":"12XtYwT3sM7pBq0c","project":{"updatedAt":"2026-09-04T01:21:44.285Z","createdAt":"2026-09-02T10:57:01.828Z","id":"12XtYwT3sM7pBq0c","name":"귀영 문 <6455738e@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"a95ec313-40c5-43cf-b5f4-954930c7c424"}}],"versionMetadata":{"name":null,"description"