{"updatedAt":"2026-09-10T09:31:24.404Z","createdAt":"2026-09-04T11:58:45.342Z","id":"awi7k6v7jnSgjDn3","name":"이번 주 구글 캘린더 일정 → 슬랙 #n8n 알림","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"weeks","triggerAtDay":[1],"triggerAtHour":9}]}},"id":"b1c2d3e4-0001-4a11-9a11-000000000001","name":"매주 월요일 오전 9시","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-448,0]},{"parameters":{},"id":"b1c2d3e4-0002-4a11-9a11-000000000002","name":"수동 실행","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[-448,192]},{"parameters":{"assignments":{"assignments":[{"id":"c1","name":"weekStart","type":"string","value":"={{ $now.startOf('week').toISO() }}"},{"id":"c2","name":"weekEnd","type":"string","value":"={{ $now.startOf('week').plus({ days: 7 }).toISO() }}"},{"id":"c3","name":"weekStartLabel","type":"string","value":"={{ $now.startOf('week').toFormat('M/d(EEE)') }}"},{"id":"c4","name":"weekEndLabel","type":"string","value":"={{ $now.startOf('week').plus({ days: 6 }).toFormat('M/d(EEE)') }}"}]},"options":{}},"id":"b1c2d3e4-0003-4a11-9a11-000000000003","name":"이번 주 범위 계산","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-208,96]},{"parameters":{"operation":"getAll","calendar":{"__rl":true,"value":"6455738e@gmail.com","mode":"list","cachedResultName":"6455738e@gmail.com"},"returnAll":true,"timeMin":"={{ $json.weekStart }}","timeMax":"={{ $json.weekEnd }}","options":{"orderBy":"startTime"}},"id":"b1c2d3e4-0004-4a11-9a11-000000000004","name":"구글 캘린더 일정 조회","type":"n8n-nodes-base.googleCalendar","typeVersion":1.3,"position":[32,96],"credentials":{"googleCalendarOAuth2Api":{"id":"86vyLz49q8XE0hhq","name":"Google Calendar account"}}},{"parameters":{"jsCode":"const events = $input.all();\n\nconst weekStart = $('이번 주 범위 계산').first().json.weekStartLabel;\nconst weekEnd = $('이번 주 범위 계산').first().json.weekEndLabel;\n\nif (events.length === 0 || events.every((e) => !e.json.id)) {\n  return [{\n    json: {\n      text: `📅 이번 주(${weekStart} ~ ${weekEnd}) 일정 알림\\n\\n등록된 일정이 없습니다.`,\n    },\n  }];\n}\n\nconst lines = events\n  .map((e) => e.json)\n  .sort((a, b) => new Date(a.start?.dateTime || a.start?.date) - new Date(b.start?.dateTime || b.start?.date))\n  .map((ev) => {\n    const isAllDay = !!ev.start?.date;\n    let when;\n    if (isAllDay) {\n      when = `${ev.start.date} (종일)`;\n    } else {\n      const start = new Date(ev.start.dateTime);\n      const end = new Date(ev.end.dateTime);\n      const fmt = (d) => d.toLocaleString('ko-KR', {\n        month: 'numeric', day: 'numeric', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false,\n      });\n      when = `${fmt(start)} ~ ${fmt(end)}`;\n    }\n    const title = ev.summary || '(제목 없음)';\n    const location = ev.location ? `\\n   📍 ${ev.location}` : '';\n    return `• *${title}*\\n   🕒 ${when}${location}`;\n  });\n\nconst text = `📅 이번 주(${weekStart} ~ ${weekEnd}) 일정 알림 (${events.length}건)\\n\\n${lines.join('\\n\\n')}`;\n\nreturn [{ json: { text } }];"},"id":"b1c2d3e4-0005-4a11-9a11-000000000005","name":"슬랙 메시지 포맷팅","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,96]},{"parameters":{"select":"channel","channelId":{"mode":"name","value":"#n8n"},"text":"={{ $json.text }}","otherOptions":{}},"id":"b1c2d3e4-0006-4a11-9a11-000000000006","name":"슬랙 #n8n 에 전송","type":"n8n-nodes-base.slack","typeVersion":2.3,"position":[464,96],"webhookId":"5b71db13-28ed-4042-9584-291e1dcb258c","credentials":{"slackApi":{"id":"lL2Vqet1dPhgO8fJ","name":"Slack account"}}}],"connections":{"매주 월요일 오전 9시":{"main":[[{"node":"이번 주 범위 계산","type":"main","index":0}]]},"수동 실행":{"main":[[{"node":"이번 주 범위 계산","type":"main","index":0}]]},"이번 주 범위 계산":{"main":[[{"node":"구글 캘린더 일정 조회","type":"main","index":0}]]},"구글 캘린더 일정 조회":{"main":[[{"node":"슬랙 메시지 포맷팅","type":"main","index":0}]]},"슬랙 메시지 포맷팅":{"main":[[{"node":"슬랙 #n8n 에 전송","type":"main","index":0}]]}},"settings":{"saveExecutionProgress":true,"saveManualExecutions