{"updatedAt":"2026-09-10T09:31:27.372Z","createdAt":"2026-09-08T09:11:12.053Z","id":"OqMiSy0hyRScg0es","name":"[공통] 카카오톡 나에게 알림 전송 (Webhook)","description":null,"active":true,"isArchived":false,"nodes":[{"id":"d4e5f6a7-0001-4000-8000-000000000001","name":"Webhook 수신","webhookId":"b4855997-16a1-47be-b1c7-4d2d32bc1670","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[240,304],"parameters":{"httpMethod":"POST","path":"kakao-notify","responseMode":"responseNode","options":{}}},{"id":"d4e5f6a7-0003-4000-8000-000000000003","name":"메시지 조립","type":"n8n-nodes-base.code","typeVersion":2,"position":[544,304],"parameters":{"mode":"runOnceForEachItem","jsCode":"// Webhook 본문에서 메시지/링크 추출\nconst hook = $('Webhook 수신').item.json;\nconst payload = hook.body || hook.query || {};\nconst message = (payload.message || payload.text || '알림').toString();\nconst link = (payload.link || payload.url || '').toString();\n\nconst templateObject = {\n  object_type: 'text',\n  text: message,\n  link: link\n    ? { web_url: link, mobile_web_url: link }\n    : { web_url: 'https://developers.kakao.com', mobile_web_url: 'https://developers.kakao.com' },\n};\nif (link) templateObject.button_title = '열기';\n\nreturn {\n  json: {\n    template_object: JSON.stringify(templateObject),\n  },\n};\n"}},{"id":"d4e5f6a7-0004-4000-8000-000000000004","name":"카카오 나에게 전송","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[800,304],"parameters":{"method":"POST","url":"https://kapi.kakao.com/v2/api/talk/memo/default/send","authentication":"genericCredentialType","genericAuthType":"oAuth2Api","sendBody":true,"contentType":"form-urlencoded","bodyParameters":{"parameters":[{"name":"template_object","value":"={{ $json.template_object }}"}]},"options":{}},"credentials":{"oAuth2Api":{"id":"Nzffqx0TXt5bxf1B","name":"Kakao OAuth2"}}},{"id":"d4e5f6a7-0005-4000-8000-000000000005","name":"응답 반환","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[1200,304],"parameters":{"respondWith":"json","responseBody":"={{ { \"ok\": true, \"kakao\": $json } }}","options":{}}}],"connections":{"Webhook 수신":{"main":[[{"node":"메시지 조립","type":"main","index":0}]]},"메시지 조립":{"main":[[{"node":"카카오 나에게 전송","type":"main","index":0}]]},"카카오 나에게 전송":{"main":[[{"node":"응답 반환","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","errorWorkflow":"d0cJdb6254pCsYsY"},"staticData":null,"meta":null,"nodeGroups":[],"pinData":null,"versionId":"a1fbf406-3591-479d-b641-1f320ebc63ca","activeVersionId":"a1fbf406-3591-479d-b641-1f320ebc63ca","versionCounter":3,"triggerCount":1,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-09-08T09:11:12.053Z","createdAt":"2026-09-08T09:11:12.053Z","role":"workflow:owner","workflowId":"OqMiSy0hyRScg0es","projectId":"12XtYwT3sM7pBq0c","project":{"updatedAt":"2026-09-04T01:21:44.285Z","createdAt":"2026-09-02T10:57:01.828Z","id":"12XtYwT3sM7pBq0c","name":"귀영 문 <6455738e@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"a95ec313-40c5-43cf-b5f4-954930c7c424"}}],"versionMetadata":{"name":null,"description":null}}